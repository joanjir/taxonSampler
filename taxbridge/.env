# Local environment variables for ProyectoNCBI_COL
# --- REQUIRED (replace placeholders) ---
DJANGO_SECRET_KEY=changeme_replace_with_secure_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: set to a real GitHub personal access token (scopes: repo or public_repo to create issues)
GITHUB_TOKEN=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
# GitHub repo to open/create issues against (owner/repo)
