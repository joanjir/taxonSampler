# Optional: an email address to receive report submissions when GitHub is not available
REPORT_EMAIL=admin@example.com
DEFAULT_FROM_EMAIL=webmaster@example.com
# If true (default) require GITHUB_TOKEN and always create issues on GitHub.
# Set to False to allow email fallback when GITHUB_TOKEN is not configured.
REPORT_ALWAYS_GITHUB=True

# Optional API keys
NCBI_API_KEY=b556d0e0426848b123f1b1ccc1e3e556ec08
NCBI_USER_AGENT=taxbridge/0.1

# Database URL (sqlite default)
